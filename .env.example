# Copier en .env (jamais commité). Voir docs/architecture.md §8.

# --- apps/api ---
# development | test | production
APP_ENV=development
API_PORT=4000
# Vide en dev/test ⇒ PGlite en mémoire. `pglite://./.data/dev` ⇒ PGlite persisté sur disque
# (dev local sans Docker). URL PostgreSQL managée (Neon, Supabase…) en production. PGlite est
# refusé si APP_ENV=production.
DATABASE_URL=
# `true` active POST /auth/dev (refusé si APP_ENV=production).
ENABLE_DEV_LOGIN=true

# Sign in with Apple (ADR 001) : audience du jeton, identifiants du client_secret ES256.
APPLE_BUNDLE_ID=fr.tristanbqn.footer
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# 32 octets base64 : chiffrement AES-256-GCM des refresh tokens Apple au repos.
APPLE_TOKEN_ENC_KEY=

# Notifications push (ADR 004). apns en production ; console (boîte d'envoi en mémoire) en dev/test.
PUSH_TRANSPORT=console
APNS_KEY_ID=
APNS_PRIVATE_KEY=

# Lire X-Forwarded-For pour la limitation de débit (selon hébergeur).
TRUST_PROXY=false

# Relève le débit /auth/* (par défaut RATE_LIMIT_AUTH_PER_MINUTE_PER_IP, @app/contracts) pour les
# E2E Playwright (beaucoup d'utilisateurs créés depuis une même IP). Fixée uniquement par le
# script `start:e2e` : ne jamais la définir ailleurs, refus au démarrage si APP_ENV=production.
# E2E_AUTH_RATE_LIMIT=1000

# --- apps/mobile ---
EXPO_PUBLIC_API_URL=http://localhost:4000
# healthkit | simulated. Refusé si le profil EAS est `production`.
EXPO_PUBLIC_HEALTH_SOURCE=simulated
