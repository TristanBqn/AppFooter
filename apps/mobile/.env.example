# Copier en .env (jamais commité). Variables lues par Expo (préfixe EXPO_PUBLIC_ requis
# pour être inlinées dans le bundle). Documentées aussi dans docs/architecture.md §8.

# URL de l'API (apps/api, port 4000 en local).
EXPO_PUBLIC_API_URL=http://localhost:4000

# "healthkit" (par défaut, dev build réel) ou "simulated" (dev local / aperçu web / tests).
# Refusé si le profil EAS est "production" (garde au démarrage, voir ADR 002 et la tâche M3).
EXPO_PUBLIC_HEALTH_SOURCE=simulated
